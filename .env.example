# Application
NODE_ENV=development
PORT=3010

# Development database only. E2E uses .env.test → welapathkade_test (see docs/e2e-database.md).
DATABASE_URL="mysql://welapathkade:welapathkade@localhost:3307/welapathkade"
REDIS_URL="redis://localhost:6380"

# Authentication
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# Business
BUSINESS_TIMEZONE="Asia/Colombo"

# Push notifications (Phase 6B). Optional: console | noop.
# Default: console in development, noop otherwise. No real FCM delivery exists yet.
# NOTIFICATIONS_FCM_PROVIDER="console"

# Browser clients (comma-separated). Used by Nest CORS for the admin panel.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Agora RTC (server-side only). Both must be set together, or both unset.
# App ID is returned to authenticated clients; App Certificate must NEVER leave the API.
# AGORA_APP_ID="your-agora-app-id"
# AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# Dev/test only: when true, appointment proposals may start 5 minutes ahead
# (instead of 60) so Agora video can be tested immediately. Default: false.
# Production startup rejects this when set to true.
# ALLOW_SHORT_NOTICE_TEST_APPOINTMENTS=true

# Required. Base64-encoded 32-byte AES-256-GCM key for astrologer bank account numbers.
# Server only. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not commit a real key. The all-0x42 test key is rejected in production.
# BANK_ACCOUNT_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# Private consultation attachments.
# Development and tests use local disk (not served publicly). Production startup
# rejects STORAGE_DRIVER=local and requires the S3-compatible settings below.
# Do not commit real keys. Downloads are streamed by the API; no public URLs.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=storage/private
# STORAGE_BUCKET=private-consultations
# Limits (optional; defaults are 5 documents/photos, 1 voice note, 10 MB, 3 minutes).
# ATTACHMENT_MAX_DOCUMENTS=5
# ATTACHMENT_MAX_VOICE_NOTES=1
# ATTACHMENT_MAX_DOCUMENT_BYTES=10485760
# ATTACHMENT_MAX_VOICE_BYTES=10485760
# ATTACHMENT_MAX_VOICE_SECONDS=180
# Unlinked uploads older than this are deleted. Linked files are kept.
# ATTACHMENT_ABANDONED_HOURS=24
#
# Cloudflare R2 (required in production):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=private-consultations
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
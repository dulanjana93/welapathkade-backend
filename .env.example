# Application
NODE_ENV=development
PORT=3010

# Development database only. E2E uses .env.test → welapathkade_test (see docs/e2e-database.md).
DATABASE_URL="mysql://welapathkade:welapathkade@localhost:3307/welapathkade"
REDIS_URL="redis://localhost:6380"

# Authentication
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# SMS OTP via Notify.lk (https://developer.notify.lk/api-endpoints/).
# Development and test keep the console sender and do not call Notify.lk.
# Production requires all three and does not allow the console sender.
# NOTIFY_LK_SENDER_ID must be approved in the Notify.lk dashboard before
# production OTP delivery. NotifyDEMO stays rejected unless hosted sandbox
# testing is explicitly authorized.
# Setting true is permitted only with NODE_ENV=production,
# PAYHERE_MODE=sandbox, and PAYHERE_ALLOW_SANDBOX=true.
NOTIFY_LK_ALLOW_DEMO_SENDER=false
# NOTIFY_LK_USER_ID="your-notify-user-id"
# NOTIFY_LK_API_KEY="your-notify-api-key"
# NOTIFY_LK_SENDER_ID="YourApprovedSenderId"

# Business
BUSINESS_TIMEZONE="Asia/Colombo"

# Push notifications (Phase 6B). Optional: console | noop.
# Default: console in development, noop otherwise. No real FCM delivery exists yet.
# NOTIFICATIONS_FCM_PROVIDER="console"

# Browser clients (comma-separated). Used by Nest CORS for the admin panel.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Agora RTC (server-side only). Both must be set together, or both unset.
# App ID is returned to authenticated clients; App Certificate must NEVER leave the API.
# AGORA_APP_ID="your-agora-app-id"
# AGORA_APP_CERTIFICATE="your-agora-app-certificate"

# Dev/test only: when true, appointment proposals may start 5 minutes ahead
# (instead of 60) so Agora video can be tested immediately. Default: false.
# Production startup rejects this when set to true.
# ALLOW_SHORT_NOTICE_TEST_APPOINTMENTS=true

# Required. Base64-encoded 32-byte AES-256-GCM key for astrologer bank account numbers.
# Server only. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not commit a real key. The all-0x42 test key is rejected in production.
# BANK_ACCOUNT_ENCRYPTION_KEY="replace-with-base64-32-byte-key"

# Private consultation attachments.
# Development and tests use local disk (not served publicly). Production startup
# rejects STORAGE_DRIVER=local and requires the S3-compatible settings below.
# Do not commit real keys. Downloads are streamed by the API; no public URLs.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=storage/private
# STORAGE_BUCKET=private-consultations
# Limits (optional; defaults are 5 documents/photos, 1 voice note, 10 MB, 3 minutes).
# ATTACHMENT_MAX_DOCUMENTS=5
# ATTACHMENT_MAX_VOICE_NOTES=1
# ATTACHMENT_MAX_DOCUMENT_BYTES=10485760
# ATTACHMENT_MAX_VOICE_BYTES=10485760
# ATTACHMENT_MAX_VOICE_SECONDS=180
# Unlinked uploads older than this are deleted. Linked files are kept.
# ATTACHMENT_ABANDONED_HOURS=24
#
# Cloudflare R2 (required in production):
# STORAGE_DRIVER=s3
# Account endpoint only. Do not append /<bucket>; S3_BUCKET is sent separately.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=private-consultations
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# PayHere one-time checkout. Leave PAYHERE_MODE unset in development and test
# to keep the mock gateway. Production requires PAYHERE_MODE=live and the live
# www checkout and OAuth URLs below. Do not put sandbox credentials in production.
# A real sandbox test needs a public HTTPS notify URL. This API does not open a
# tunnel. The browser return URL is not proof of payment.
# PAYHERE_MODE=sandbox
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=
# PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
# PAYHERE_OAUTH_URL=https://sandbox.payhere.lk/merchant/v1/oauth/token
# PAYHERE_NOTIFY_URL=https://api.example.com/payments/callbacks/payhere
# PAYHERE_RETURN_URL=https://app.example.com/payments/return
# PAYHERE_CANCEL_URL=https://app.example.com/payments/cancel
# Live:
# PAYHERE_MODE=live
# PAYHERE_CHECKOUT_URL=https://www.payhere.lk/pay/checkout
# PAYHERE_OAUTH_URL=https://www.payhere.lk/merchant/v1/oauth/token
# Refunds use the same OAuth app. POST /merchant/v1/payment/refund and
# retrieval follow PAYHERE_MODE. There is no separate refund URL setting.
# With PAYHERE_MODE unset, the mock gateway is used and no refund is sent.
# Apply prisma migrations locally before a sandbox refund can be stored.
# Admin list/inspect: GET /admin/finance/refunds
# Admin reconcile: POST /admin/finance/refunds/reconcile
# Admin retry (only after retrieval shows the refund never started):
# POST /admin/finance/refunds/:id/retry
# The expiry sweep also starts due refunds and reconciles unresolved ones.
# A refund obligation, a PayHere refund request, and a ledger reversal are
# separate. Do not send a live refund from this machine unless you intend to.
# Saved cards use the same merchant id, secret, and notify URL.
# Pre-approval posts to https://sandbox.payhere.lk/pay/preapprove or
# https://www.payhere.lk/pay/preapprove. That URL is not a separate setting.
# The form does not send amount. The hash uses 10.00 for LKR.
# PayHere charges Rs. 1.00 to verify the card and refunds it immediately.
# That is not a consultation payment.
# Saved-card consultation charges use POST /merchant/v1/payment/charge.
# That URL follows PAYHERE_MODE and is not a separate setting.
# The charge type is PAYMENT. AUTHORIZE is not used.
# The customer must confirm the charge. Accepting a proposal does not charge.
# An uncertain charge is reconciled with Retrieval. It is not retried automatically.
# Live charging also needs PayHere to whitelist the server IP and notify domain.
# Revoking a card in this API deletes the local token. It does not call PayHere.
# PayHere pre-approval cancellation is done in the PayHere merchant account.
# Apply prisma migrations locally before a saved-card charge can be stored.
# Admin list: GET /admin/finance/saved-card-charges
# Admin reconcile (Retrieval only, no second charge):
# POST /admin/finance/saved-card-charges/reconcile
# E2E / isolated test environment ONLY.
# Copy to .env.test (gitignored). Never point this at welapathkade (development).

NODE_ENV=test
# Optional: ALLOW_SHORT_NOTICE_TEST_APPOINTMENTS=true
PORT=3010

# Isolated test database — MUST be welapathkade_test
DATABASE_URL="mysql://welapathkade:welapathkade@localhost:3307/welapathkade_test"
REDIS_URL="redis://localhost:6380"

JWT_ACCESS_SECRET="change-me-test"
JWT_REFRESH_SECRET="change-me-test"

BUSINESS_TIMEZONE="Asia/Colombo"

CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Agora RTC placeholders for tests only (not real credentials).
# AGORA_APP_ID="test-agora-app-id"
# AGORA_APP_CERTIFICATE="test-agora-app-certificate"

# Test-only AES-256-GCM key (32 bytes of 0x42). Rejected when NODE_ENV=production.
BANK_ACCOUNT_ENCRYPTION_KEY="QkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkI="

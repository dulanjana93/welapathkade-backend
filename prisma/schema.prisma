// Welapathkade Phase 1–5B (Auth … Proposals + Reservation + Mock Payment) + Phase 6B (Notifications)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PUBLIC
  ASTROLOGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Language {
  SI
  EN
}

enum OtpPurpose {
  /// @deprecated Prefer PUBLIC_REGISTRATION — kept for backward-compatible clients.
  REGISTRATION
  PUBLIC_REGISTRATION
  ASTROLOGER_REGISTRATION
  LOGIN
  PHONE_CHANGE
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AstrologerProfileStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AstrologerApplicationStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  APPROVED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum AstrologerServiceStatus {
  ACTIVE
  INACTIVE
}

/// Local Asia/Colombo weekday for recurring weekly availability.
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AvailabilityExceptionType {
  UNAVAILABLE
  AVAILABLE_OVERRIDE
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  /// Closed without a held session: customer cancelled the request, or the linked
  /// appointment was cancelled / a no-show. The exact reason lives on the Appointment.
  CANCELLED
  /// The linked appointment completed via a verified session-end event.
  COMPLETED
}

/// Appointment time proposal (not a booking / reservation / payment).
enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum FileProvider {
  CLOUDFLARE_R2
  LOCAL
}

enum FileStatus {
  UPLOADING
  AVAILABLE
  DELETED
}

enum ConsultationFileType {
  KUNDALI
  VOICE_NOTE
  DOCUMENT
  IMAGE
}

/// V1 booking hold / confirmed appointment (not the full later lifecycle).
enum AppointmentStatus {
  PAYMENT_PENDING
  CONFIRMED
  PAYMENT_EXPIRED
  /// Legacy Phase 5B value. Never written by the lifecycle; use the explicit CANCELLED_BY_* values.
  CANCELLED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_ASTROLOGER
  /// Customer absent, astrologer present. Requires manual review before any settlement.
  NO_SHOW_CUSTOMER
  /// Astrologer absent, customer present. 100% refund obligation.
  NO_SHOW_ASTROLOGER
  /// Neither participant joined. 100% refund obligation; no earnings or commissions.
  NO_SHOW_BOTH
}

/// A refund the platform OWES the customer. This records an obligation only —
/// it does not mean money was refunded (refund processing is a later phase).
enum RefundObligation {
  FULL_REFUND_DUE
}

enum ReliabilityIncidentType {
  CANCELLATION
  NO_SHOW
}

/// Participant role on a verified video-session attendance evidence row.
enum SessionAttendanceParticipantRole {
  CUSTOMER
  ASTROLOGER
}

/// Join/leave fact kinds. B3-a records facts only; it does not infer no-show outcomes.
enum SessionAttendanceEventKind {
  PARTICIPANT_JOINED
  PARTICIPANT_LEFT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum PayHereRefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REQUIRES_REVIEW
}

enum PayHereRefundReason {
  RESERVATION_EXPIRED
  CANCELLATION
  NO_SHOW
  ADMIN_RETRY
}

enum PaymentProvider {
  MOCK
  PAYHERE
}

enum SavedCardStatus {
  PENDING
  ACTIVE
  DISABLED
  REMOVED
  FAILED
}

/// Why a saved-card registration ended FAILED. Internal; the customer API maps
/// it to DECLINED, CANCELLED, or NOT_CONFIRMED.
enum SavedCardFailureReason {
  /// Verified PayHere notify status -2.
  PAYHERE_DECLINED
  /// Verified PayHere notify status -1.
  PAYHERE_CANCELLED
  /// The app reported that the customer cancelled the PayHere page.
  CUSTOMER_CANCELLED
  /// The registration flow completed without a verified PayHere success.
  NOT_CONFIRMED
  /// The customer started a new registration while this one was open.
  SUPERSEDED
  /// The app never completed the flow. Failed by the expiry sweep backstop.
  ABANDONED
  /// Resolved by the one-off legacy PENDING cleanup script.
  LEGACY_PENDING
}

enum SavedCardConsentEventType {
  CONSENT_GRANTED
  CONSENT_REVOKED
  CARD_REMOVED
}

model User {
  id               String     @id @default(cuid())
  phone            String     @unique
  /// Required for ADMIN email/password login. Null for PUBLIC/ASTROLOGER.
  email            String?    @unique
  /// Argon2id hash. Required for ADMIN. Never returned via API.
  passwordHash     String?    @db.VarChar(255)
  name             String
  /// PayHere billing name. Null until the customer completes checkout billing.
  /// Does not replace `name`.
  billingFirstName String?   @db.VarChar(80)
  billingLastName  String?   @db.VarChar(80)
  /// Billing email for payment checkout. Null until provided. Not a login
  /// credential and not unique: `email` remains the admin login address.
  billingEmail     String?   @db.VarChar(254)
  billingAddress   String?   @db.VarChar(255)
  billingCity      String?   @db.VarChar(80)
  /// Trimmed country name, or an uppercase ISO 3166-1 alpha-2 code.
  billingCountry   String?   @db.VarChar(80)
  role             UserRole
  status           UserStatus @default(ACTIVE)
  language         Language   @default(SI)
  /// Private profile picture. Bytes live in object storage, never in this row.
  profilePictureFileId String? @unique
  referralCode     String     @unique
  referredByUserId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  referredBy  User?  @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals   User[] @relation("UserReferrals")

  profilePicture       File?                    @relation("UserProfilePicture", fields: [profilePictureFileId], references: [id], onDelete: Restrict)
  sessions             UserSession[]
  devices              UserDevice[]
  otpVerifications     OtpVerification[]
  astrologerProfile    AstrologerProfile?
  auditLogs            AuditLog[]              @relation("AuditLogAdmin")
  reviewedApplications AstrologerApplication[] @relation("ApplicationReviewer")
  uploadedFiles        File[]                  @relation("FileUploader")
  consultationsAsCustomer Consultation[]       @relation("ConsultationCustomer")
  appointmentsAsCustomer  Appointment[]        @relation("AppointmentCustomer")
  consultationFollowUpMessages ConsultationFollowUpMessage[]
  consultationReviews     ConsultationReview[] @relation("ConsultationReviewCustomer")
  notifications           Notification[]
  walletAccount           WalletAccount?
  ledgerEntries           LedgerEntry[]
  bankAccounts            AstrologerBankAccount[]
  withdrawalRequests      WithdrawalRequest[] @relation("WithdrawalOwner")
  withdrawalDebits        WithdrawalDebit[]
  withdrawalEvents        WithdrawalEvent[]   @relation("WithdrawalEventActor")
  withdrawalsApproved     WithdrawalRequest[] @relation("WithdrawalApprovedBy")
  withdrawalsRejected     WithdrawalRequest[] @relation("WithdrawalRejectedBy")
  withdrawalsPaid         WithdrawalRequest[] @relation("WithdrawalPaidBy")
  withdrawalsCancelled    WithdrawalRequest[] @relation("WithdrawalCancelledBy")
  /// Admin-only referral attribution corrections targeting this user.
  referralCorrectionsAsTarget ReferralAttributionCorrection[] @relation("ReferralCorrectionTarget")
  /// Admin actor rows for referral attribution corrections.
  referralCorrectionsAsAdmin  ReferralAttributionCorrection[] @relation("ReferralCorrectionAdmin")
  savedPaymentMethods SavedPaymentMethod[]
  savedCardConsentEvents SavedCardConsentEvent[]

  @@index([referredByUserId])
}

model UserSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  deviceId         String?
  ip               String?
  userAgent        String?   @db.VarChar(512)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
}

model OtpVerification {
  id         String     @id @default(cuid())
  userId     String?
  phone      String
  purpose    OtpPurpose
  codeHash   String
  status     OtpStatus  @default(PENDING)
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([expiresAt])
  @@index([phone, purpose, status])
}

model UserDevice {
  id         String         @id @default(cuid())
  userId     String
  fcmToken   String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AstrologerProfile {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  displayName     String
  bio             String?                 @db.Text
  experienceYears Int                     @default(0)
  photo           String?
  city            String?
  district        String?
  /// Operational status (ACTIVE / INACTIVE / SUSPENDED). Separate from application status.
  status          AstrologerProfileStatus @default(INACTIVE)
  /// Manual presence: accepting new consultation requests. Independent of weekly
  /// availability, appointments and Agora call state. Defaults Offline.
  isOnline        Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  services               AstrologerService[]
  application            AstrologerApplication?
  weeklyAvailability     WeeklyAvailability[]
  availabilityExceptions AvailabilityException[]
  bookingGuard           AstrologerBookingGuard?
  consultations          Consultation[]
  appointments           Appointment[]
  reliabilityIncidents   AstrologerReliabilityIncident[]
  reviews                ConsultationReview[]
  financialSnapshots     AppointmentFinancialSnapshot[]

  @@index([status])
  @@index([isOnline])
  @@index([city])
  @@index([district])
}

model AstrologerApplication {
  id                  String                      @id @default(cuid())
  astrologerProfileId String                      @unique
  status              AstrologerApplicationStatus @default(DRAFT)
  rejectionReason     String?                     @db.Text
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedByAdminId   String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  profile    AstrologerProfile @relation(fields: [astrologerProfileId], references: [id], onDelete: Cascade)
  reviewedBy User?             @relation("ApplicationReviewer", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reviewedByAdminId])
}

model Service {
  id            String        @id @default(cuid())
  code          String        @unique
  nameSi        String
  nameEn        String
  descriptionSi String?       @db.Text
  descriptionEn String?       @db.Text
  minPrice      Decimal       @db.Decimal(12, 2)
  maxPrice      Decimal       @db.Decimal(12, 2)
  status        ServiceStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  astrologerServices AstrologerService[]
  consultations      Consultation[]

  @@index([status])
}

model AstrologerService {
  id           String                  @id @default(cuid())
  astrologerId String
  serviceId    String
  price        Decimal                 @db.Decimal(12, 2)
  status       AstrologerServiceStatus @default(ACTIVE)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  astrologer    AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
  service       Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  consultations Consultation[]

  @@unique([astrologerId, serviceId])
  @@index([astrologerId])
  @@index([serviceId])
  @@index([status])
  @@index([price])
}

/// Recurring local Asia/Colombo weekly window (not a UTC timestamp).
model WeeklyAvailability {
  id           String    @id @default(cuid())
  astrologerId String
  dayOfWeek    DayOfWeek
  /// Local clock time HH:mm in Asia/Colombo
  startTime    String    @db.VarChar(5)
  /// Local clock time HH:mm in Asia/Colombo
  endTime      String    @db.VarChar(5)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  astrologer AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([astrologerId])
  @@index([astrologerId, dayOfWeek])
}

/// Date-specific override of weekly availability (Asia/Colombo calendar date).
model AvailabilityException {
  id           String                    @id @default(cuid())
  astrologerId String
  /// Calendar date in Asia/Colombo (stored as DATE, no time component)
  date         DateTime                  @db.Date
  type         AvailabilityExceptionType
  /// Required for AVAILABLE_OVERRIDE (local HH:mm)
  startTime    String?                   @db.VarChar(5)
  /// Required for AVAILABLE_OVERRIDE (local HH:mm)
  endTime      String?                   @db.VarChar(5)
  reason       String?                   @db.VarChar(500)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  astrologer AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Cascade)

  @@index([astrologerId])
  @@index([astrologerId, date])
}

/// Sync primitive for future appointment reservations (SELECT … FOR UPDATE).
model AstrologerBookingGuard {
  astrologerId String   @id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  astrologer AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Cascade)
}

/// Customer consultation request (preferred time only — not an appointment).
model Consultation {
  id                 String             @id @default(cuid())
  customerId         String
  astrologerId       String
  astrologerServiceId String
  serviceId          String
  /// Snapshotted price at request time (DECIMAL string-safe).
  requestedPrice     Decimal            @db.Decimal(12, 2)
  /// Snapshotted service names (prices/names may change later).
  serviceNameSi      String
  serviceNameEn      String
  message            String?            @db.Text
  status             ConsultationStatus @default(PENDING)
  /// Customer's preferred start (UTC). NOT appointmentStartAt.
  preferredStartAt   DateTime
  /// Optional preferred end window (UTC). Preference only — not final duration.
  preferredEndAt     DateTime?
  submittedAt        DateTime
  viewedAt           DateTime?
  respondedAt        DateTime?
  expiresAt          DateTime
  declineReason      String?            @db.VarChar(500)
  completedAt        DateTime?
  /// Optional plain-text note written by the assigned astrologer after completion.
  astrologerSummary  String?            @db.Text
  astrologerSummaryUpdatedAt DateTime?
  /// Optional Idempotency-Key for one logical customer submission. Null when the client omits it.
  clientIdempotencyKey String?          @db.VarChar(80)
  /// SHA-256 of the logical create payload, stored with [clientIdempotencyKey].
  requestFingerprint   String?          @db.VarChar(64)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer         User              @relation("ConsultationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  astrologer       AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  astrologerService AstrologerService @relation(fields: [astrologerServiceId], references: [id], onDelete: Restrict)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  files            ConsultationFile[]
  proposals        ConsultationProposal[]
  appointments     Appointment[]
  payments         Payment[]
  followUpMessages ConsultationFollowUpMessage[]
  review           ConsultationReview?
  financialSnapshots AppointmentFinancialSnapshot[]
  ledgerEntries      LedgerEntry[]

  @@unique([customerId, clientIdempotencyKey])
  @@index([customerId])
  @@index([astrologerId])
  @@index([status])
  @@index([expiresAt])
  @@index([submittedAt])
  @@index([astrologerId, status, submittedAt])
  @@index([customerId, status, submittedAt])
  @@index([status, expiresAt])
}

/// Customer star rating + optional text for one successfully completed consultation.
/// At most one review per consultation (@@unique consultationId). Public aggregates
/// only count rows whose consultation remains eligible (see review eligibility helper).
model ConsultationReview {
  id             String   @id @default(cuid())
  consultationId String   @unique
  customerId     String
  /// AstrologerProfile.id of the reviewed astrologer.
  astrologerId   String
  /// Integer stars 1–5.
  rating         Int
  /// Optional plain-text body; null when empty/whitespace.
  body           String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation Consultation     @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  customer     User             @relation("ConsultationReviewCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  astrologer   AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Restrict)

  @@index([astrologerId, createdAt])
  @@index([customerId])
  @@index([astrologerId, rating])
}

/// Text-only post-session follow-up message scoped to one completed consultation.
/// Retained permanently after the 48-hour send window expires.
model ConsultationFollowUpMessage {
  id             String   @id @default(cuid())
  consultationId String
  /// Authenticated sender; never taken from the client body.
  senderUserId   String
  body           String   @db.VarChar(2000)
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([consultationId, createdAt])
  @@index([consultationId, senderUserId])
}

/// Astrologer-proposed appointment time for an ACCEPTED consultation.
/// Not a reservation, payment, or confirmed appointment (Phase 5B+).
model ConsultationProposal {
  id               String         @id @default(cuid())
  consultationId   String
  /// Proposed start instant (UTC). Validated against Asia/Colombo availability.
  proposedStartAt  DateTime
  /// Derived: proposedStartAt + durationMinutes (UTC).
  proposedEndAt    DateTime
  durationMinutes  Int
  status           ProposalStatus @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  respondedAt      DateTime?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  appointment  Appointment?

  @@index([consultationId])
  @@index([consultationId, status])
  @@index([status])
  @@index([proposedStartAt])
}

/// Confirmed booking or timed payment hold. Created at Confirm & Pay only.
model Appointment {
  id                   String            @id @default(cuid())
  consultationId       String
  proposalId           String            @unique
  customerId           String
  astrologerId         String
  /// Copied from accepted proposal (UTC). Never from the client.
  startAt              DateTime
  /// Copied from accepted proposal (UTC). Never from the client.
  endAt                DateTime
  durationMinutes      Int
  status               AppointmentStatus @default(PAYMENT_PENDING)
  /// Copied from Consultation.requestedPrice. Never from the client.
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("LKR") @db.VarChar(8)
  reservationExpiresAt DateTime
  confirmedAt          DateTime?
  /// Verified session facts (UTC). Set only by the lifecycle service from backend-validated events.
  sessionStartedAt     DateTime?
  sessionEndedAt       DateTime?
  actualDurationSeconds Int?
  /// Provider event ids that authorised start/end; unique so one event can never apply twice.
  sessionStartEventId  String?           @unique
  sessionEndEventId    String?           @unique
  cancelledAt          DateTime?
  cancelReason         String?           @db.VarChar(500)
  noShowRecordedAt     DateTime?
  /// Set when the customer is owed a full refund. NOT proof that a refund was issued.
  refundObligation     RefundObligation?
  refundObligationRecordedAt DateTime?
  /// True for NO_SHOW_CUSTOMER: settlement must not proceed until an admin resolves it.
  manualReviewRequired Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  reliabilityIncidents AstrologerReliabilityIncident[]
  attendanceEvidence   SessionAttendanceEvidence[]
  financialSnapshot    AppointmentFinancialSnapshot?
  ledgerEntries        LedgerEntry[]
  consultation Consultation        @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  proposal     ConsultationProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  customer     User                @relation("AppointmentCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  astrologer   AstrologerProfile   @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  payments     Payment[]
  payHereRefunds PayHereRefund[]

  @@index([astrologerId, status, startAt])
  @@index([customerId, status])
  @@index([consultationId])
  @@index([status, reservationExpiresAt])
}

/// Provider-neutral join/leave evidence for later investigation (Phase B3-a).
/// Inserting a row NEVER changes Appointment status, refunds, or reliability.
/// Duplicate provider deliveries are idempotent via @@unique([provider, providerEventId]).
model SessionAttendanceEvidence {
  id                 String                          @id @default(cuid())
  /// Logical provider key (e.g. future "LIVEKIT"). Not a credential.
  provider           String                          @db.VarChar(64)
  /// Provider-unique event id. Deduplicates retries.
  providerEventId    String                          @db.VarChar(191)
  /// Provider room/session id (mapped server-side to appointmentId).
  providerRoomId     String                          @db.VarChar(191)
  appointmentId      String
  participantRole    SessionAttendanceParticipantRole
  eventKind          SessionAttendanceEventKind
  /// When the provider says the event happened (UTC).
  providerOccurredAt DateTime
  /// When this API accepted the verified event (UTC).
  receivedAt         DateTime
  /// Minimal trace only: { "adapter": "<name>" }. Never tokens, URLs, or PII.
  sourceMeta         Json?
  createdAt          DateTime                        @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([appointmentId, providerOccurredAt])
  @@index([appointmentId, receivedAt])
  @@index([provider, providerRoomId])
}

/// Reliability incident against an astrologer (cancellation / no-show). One per appointment and type.
model AstrologerReliabilityIncident {
  id            String                  @id @default(cuid())
  astrologerId  String
  appointmentId String
  type          ReliabilityIncidentType
  createdAt     DateTime                @default(now())

  astrologer  AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  appointment Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, type])
  @@index([astrologerId, createdAt])
}

model Payment {
  id             String          @id @default(cuid())
  appointmentId  String          @unique
  consultationId String
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("LKR") @db.VarChar(8)
  status         PaymentStatus   @default(PENDING)
  provider       PaymentProvider @default(MOCK)
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  appointment  Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  consultation Consultation     @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  attempts     PaymentAttempt[]
  payHereRefunds PayHereRefund[]
  financialSnapshot AppointmentFinancialSnapshot?
  ledgerEntries     LedgerEntry[]

  @@index([consultationId])
  @@index([status])
}

model PaymentAttempt {
  id                String          @id @default(cuid())
  paymentId         String
  provider          PaymentProvider @default(MOCK)
  merchantReference String          @unique
  providerPaymentId String?         @unique
  status            PaymentStatus   @default(PENDING)
  checkoutPayload   Json?
  rawNotifyPayload  Json?
  /// Saved-card charge whose PayHere outcome is not known. Blocks another charge.
  requiresReview    Boolean         @default(false)
  /// Payment id while a saved-card charge is in flight, pending, or uncertain.
  openChargeSlot    String?         @unique @db.VarChar(191)
  /// Card selected for this charge. Null on attempts created before selection.
  /// Removal of the card must not delete the attempt.
  savedPaymentMethodId String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  payment            Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  savedPaymentMethod SavedPaymentMethod? @relation(fields: [savedPaymentMethodId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@index([requiresReview])
  @@index([savedPaymentMethodId])
}

/// Verified PayHere server notification. Card fields are never stored.
/// One row per order, PayHere payment id, and status code.
model PayHereNotification {
  id                String   @id @default(cuid())
  merchantReference String   @db.VarChar(191)
  /// Empty string when PayHere omits payment_id, so the unique key still holds.
  payherePaymentId  String   @default("") @db.VarChar(64)
  statusCode        Int
  amount            Decimal? @db.Decimal(12, 2)
  currency          String?  @db.VarChar(8)
  createdAt         DateTime @default(now())

  @@unique([merchantReference, payherePaymentId, statusCode], map: "PayHereNotification_merchantRef_paymentId_statusCode_key")
  @@index([merchantReference])
}

/// One PayHere refund attempt. `openRefundSlot` is the payment id while the
/// attempt is not a definitive failure, so a second full refund cannot start.
model PayHereRefund {
  id                  String              @id @default(cuid())
  paymentId           String
  appointmentId       String
  payherePaymentId    String              @db.VarChar(64)
  /// Present once PayHere returns a refund number. Not proof of a ledger reversal.
  payhereRefundNumber String?             @unique @db.VarChar(64)
  amount              Decimal             @db.Decimal(12, 2)
  currency            String              @db.VarChar(8)
  status              PayHereRefundStatus
  reason              PayHereRefundReason
  /// Payment id while this attempt blocks another refund. Null after FAILED.
  openRefundSlot      String?             @unique @db.VarChar(191)
  /// True only when retrieval shows the previous request never started.
  retrySafe           Boolean             @default(false)
  failureMessage      String?             @db.VarChar(500)
  providerStatus      Int?
  /// status, msg, and refund number only. No tokens or card fields.
  sanitizedResponse   Json?
  initiatedAt         DateTime            @default(now())
  lastReconciledAt    DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([appointmentId])
  @@index([status, updatedAt])
}

/// Customer saved card. The PayHere customer_token is stored only as
/// AES-256-GCM ciphertext. Revocation and removal null those columns.
model SavedPaymentMethod {
  id                    String          @id @default(cuid())
  userId                String
  provider              PaymentProvider @default(PAYHERE)
  status                SavedCardStatus
  merchantReference     String          @unique
  payherePaymentId      String?         @db.VarChar(64)
  tokenCiphertext       String?         @db.Text
  tokenIv               String?         @db.VarChar(32)
  tokenTag              String?         @db.VarChar(32)
  /// PayHere `method` when it is a short brand code such as VISA or MASTER.
  cardBrand             String?         @db.VarChar(16)
  /// Last four digits only when PayHere sends a masked card number.
  cardLast4             String?         @db.VarChar(4)
  consentVersion        String          @db.VarChar(32)
  consentedAt           DateTime
  authorizationEnabled  Boolean         @default(false)
  revokedAt             DateTime?
  removedAt             DateTime?
  /// User id while a registration is PENDING (only for the duration of one
  /// registration flow). Null for ACTIVE, FAILED, DISABLED, and REMOVED. A new
  /// registration supersedes an open one instead of being blocked.
  openCardSlot          String?         @unique @db.VarChar(191)
  /// Set only when status is FAILED.
  failureReason         SavedCardFailureReason?
  failedAt              DateTime?
  /// A verified PayHere success arrived after this registration was FAILED.
  /// The token was discarded and never stored. The provider-side
  /// pre-approval must be cancelled manually in the PayHere merchant portal.
  lateAuthorizationAt   DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  events          SavedCardConsentEvent[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, status])
}

model SavedCardConsentEvent {
  id                   String                    @id @default(cuid())
  userId               String
  savedPaymentMethodId String
  type                 SavedCardConsentEventType
  consentVersion       String?                   @db.VarChar(32)
  createdAt            DateTime                  @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  savedPaymentMethod SavedPaymentMethod @relation(fields: [savedPaymentMethodId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([savedPaymentMethodId])
}

/// Private object metadata. Bytes live in object storage, never in MySQL.
model File {
  id               String       @id @default(cuid())
  provider         FileProvider @default(CLOUDFLARE_R2)
  bucket           String
  objectKey        String       @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  uploadedByUserId String
  status           FileStatus   @default(UPLOADING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  uploadedBy       User               @relation("FileUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  profilePictureOwner User?             @relation("UserProfilePicture")
  consultationFiles ConsultationFile[]

  @@index([uploadedByUserId])
  @@index([status])
}

model ConsultationFile {
  id             String               @id @default(cuid())
  consultationId String
  fileId         String               @unique
  type           ConsultationFileType
  sortOrder      Int                  @default(0)
  createdAt      DateTime             @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([consultationId, fileId])
  @@index([consultationId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  oldData     Json?
  newData     Json?
  ip          String?
  createdAt   DateTime @default(now())

  admin User @relation("AuditLogAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Append-only admin correction of User.referredByUserId.
/// Application services never update or delete these rows. Not DB-permission immutable.
/// Does not rewrite AppointmentFinancialSnapshot / LedgerEntry / wallets.
model ReferralAttributionCorrection {
  id                     String   @id @default(cuid())
  targetUserId           String
  previousReferrerUserId String?
  newReferrerUserId      String?
  adminUserId            String
  /// Mandatory human reason for the correction (trimmed, max 500).
  reason                 String   @db.VarChar(500)
  createdAt              DateTime @default(now())

  targetUser User @relation("ReferralCorrectionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  admin      User @relation("ReferralCorrectionAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([adminUserId])
  @@index([createdAt])
}

/// Phase 6B: V1 notification events (stable contract for FCM `data.type`).
enum NotificationType {
  CONSULTATION_REQUESTED
  CONSULTATION_ACCEPTED
  CONSULTATION_DECLINED
  PROPOSAL_CREATED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  APPOINTMENT_CONFIRMED
}

/// One persisted notification per recipient per business event.
/// A row means "the event was recorded", NOT "the user was notified":
/// `sentAt` is set only when a push provider accepted the message.
/// Contains routing ids and generic text only — never consultation content.
model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  /// Idempotency entity: consultationId (CONSULTATION_*), proposalId (PROPOSAL_*),
  /// appointmentId (APPOINTMENT_CONFIRMED).
  referenceId String
  title       String           @db.VarChar(160)
  body        String           @db.VarChar(500)
  /// Routing ids only (type, consultationId, proposalId, appointmentId).
  data        Json
  createdAt   DateTime         @default(now())
  /// Set when at least one device push was accepted by the provider.
  sentAt      DateTime?
  /// Number of delivery runs that actually tried a provider send.
  attempts    Int              @default(0)

  /// Restrict: a user with notification history cannot be hard-deleted silently.
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, type, referenceId])
  @@index([userId, createdAt])
  @@index([sentAt, createdAt])
}

/// Financial allocation snapshot for one paid, completed appointment.
/// Phase A creates RECORDED after the 24h hold. Phase B posts ledger credits
/// and transitions to POSTED. REVERSED means linked debit entries were appended.
enum FinancialSnapshotStatus {
  /// Calculation persisted; funds have not been credited to wallets/ledger.
  RECORDED
  /// Ledger CREDIT entries posted; user wallet available balances updated.
  POSTED
  /// Linked ledger DEBIT reversals posted after a refund obligation/outcome.
  REVERSED
}

/// One authoritative financial snapshot per appointment (financial identity).
/// Recipients and amounts are frozen at creation and must never be rewritten
/// when referral attribution is later corrected.
model AppointmentFinancialSnapshot {
  id                         String                  @id @default(cuid())
  appointmentId              String                  @unique
  consultationId             String
  paymentId                  String                  @unique
  currency                   String                  @db.VarChar(8)
  /// Authoritative gross consultation amount (Payment/Appointment amount).
  grossAmount                Decimal                 @db.Decimal(12, 2)
  /// Documented basis label, e.g. GROSS_CONSULTATION_AMOUNT.
  basis                      String                  @default("GROSS_CONSULTATION_AMOUNT") @db.VarChar(64)

  astrologerId               String
  astrologerPercent          Decimal                 @db.Decimal(5, 2)
  astrologerAmount           Decimal                 @db.Decimal(12, 2)

  customerReferrerUserId     String?
  customerReferralPercent    Decimal                 @db.Decimal(5, 2)
  customerReferralAmount     Decimal                 @db.Decimal(12, 2)

  astrologerReferrerUserId   String?
  astrologerReferralPercent  Decimal                 @db.Decimal(5, 2)
  astrologerReferralAmount   Decimal                 @db.Decimal(12, 2)

  /// Residual share of G after astrologer + applicable referral allocations.
  platformPercent            Decimal                 @db.Decimal(5, 2)
  platformAmount             Decimal                 @db.Decimal(12, 2)

  status                     FinancialSnapshotStatus @default(RECORDED)
  /// Consultation completion time used as the settlement-hold clock (UTC).
  completedAt                DateTime
  /// completedAt + 24h settlement hold (UTC).
  holdExpiresAt              DateTime
  /// When ledger CREDIT entries were posted (UTC).
  postedAt                   DateTime?
  /// When ledger DEBIT reversals were posted (UTC).
  reversedAt                 DateTime?
  createdAt                  DateTime                @default(now())

  appointment  Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  consultation Consultation      @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  payment      Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  astrologer   AstrologerProfile @relation(fields: [astrologerId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([consultationId])
  @@index([astrologerId])
  @@index([status, createdAt])
  @@index([status, holdExpiresAt])
  @@index([holdExpiresAt])
  @@index([completedAt])
}

/// Category of a financial allocation derived from a snapshot.
enum LedgerCategory {
  ASTROLOGER_EARNING
  CUSTOMER_REFERRAL
  ASTROLOGER_REFERRAL
  /// Platform residual — never credited to a user wallet.
  PLATFORM_RESIDUAL
}

/// CREDIT posts availability; DEBIT reverses a prior CREDIT (append-only).
enum LedgerEntryKind {
  CREDIT
  DEBIT
}

/// Append-only financial ledger. Corrections are additional DEBIT rows linked
/// via reversesEntryId — originals are never updated or deleted.
model LedgerEntry {
  id               String         @id @default(cuid())
  /// Stable logical key, e.g. snap:{snapshotId}:ASTROLOGER_EARNING:CREDIT
  idempotencyKey   String         @unique @db.VarChar(191)
  category         LedgerCategory
  kind             LedgerEntryKind
  /// Always non-negative; kind determines wallet sign.
  amount           Decimal        @db.Decimal(12, 2)
  currency         String         @db.VarChar(8)
  /// Null only for PLATFORM_RESIDUAL (not a user wallet credit).
  userId           String?
  appointmentId    String
  consultationId   String
  paymentId        String
  snapshotId       String
  /// Set on DEBIT rows; uniquely identifies the CREDIT being reversed.
  reversesEntryId  String?        @unique
  createdAt        DateTime       @default(now())

  user         User?                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointment  Appointment                  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  consultation Consultation                 @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  payment      Payment                      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  snapshot     AppointmentFinancialSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  reversesEntry LedgerEntry?                @relation("LedgerReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy    LedgerEntry?                @relation("LedgerReversal")

  @@unique([snapshotId, category, kind])
  @@index([userId, createdAt])
  @@index([appointmentId])
  @@index([paymentId])
  @@index([category, kind])
}

/// Cached available balance for a user, always updated in the same transaction
/// as ledger posts and confirmed withdrawal debits.
/// Reconciles to ledger CREDIT − ledger DEBIT − WithdrawalDebit.
/// Pending/approved withdrawals reserve funds but do not change this balance.
/// Customers do not use this for spend in V1; astrologers/referrers do.
model WalletAccount {
  id               String   @id @default(cuid())
  userId           String   @unique
  currency         String   @default("LKR") @db.VarChar(8)
  availableBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

/// Singleton cached platform residual balance (not a user wallet).
model PlatformAccount {
  id               String   @id
  currency         String   @default("LKR") @db.VarChar(8)
  availableBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Astrologer payout request. Reservation is the row itself while
/// PENDING_REVIEW or APPROVED — wallet availableBalance is not reduced until PAID.
/// Destination fields are a snapshot copied at request time.
enum WithdrawalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAID
  /// Approved request closed without a payout, for example after a wallet shortfall.
  CANCELLED
}

/// Which earnings a withdrawal may spend. Existing rows are astrologer earnings.
enum WithdrawalPurpose {
  ASTROLOGER_EARNINGS
  CUSTOMER_REFERRAL
}

enum WithdrawalEventAction {
  CREATED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

/// Registered payout destination. Full account number is AES-256-GCM ciphertext.
model AstrologerBankAccount {
  id                      String   @id @default(cuid())
  userId                  String
  bankName                String   @db.VarChar(120)
  accountHolderName       String   @db.VarChar(120)
  branchName              String   @db.VarChar(120)
  bankCode                String?  @db.VarChar(32)
  branchCode              String?  @db.VarChar(32)
  /// Last four digits only, for masked display. Never the full number.
  accountNumberLast4      String   @db.VarChar(4)
  accountNumberCiphertext String   @db.VarChar(512)
  accountNumberIv         String   @db.VarChar(32)
  accountNumberTag        String   @db.VarChar(32)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawals WithdrawalRequest[]

  @@index([userId, isActive])
}

model WithdrawalRequest {
  id                    String           @id @default(cuid())
  userId                String
  bankAccountId         String
  amount                Decimal          @db.Decimal(12, 2)
  currency              String           @default("LKR") @db.VarChar(8)
  status                WithdrawalStatus @default(PENDING_REVIEW)
  /// Existing rows are astrologer earnings. Customer referral payouts are separate.
  purpose               WithdrawalPurpose @default(ASTROLOGER_EARNINGS)
  /// Optional client retry key. Null keys are not deduped.
  clientIdempotencyKey  String?          @db.VarChar(80)

  destinationBankName           String  @db.VarChar(120)
  destinationAccountHolderName  String  @db.VarChar(120)
  destinationBranchName         String  @db.VarChar(120)
  destinationBankCode           String? @db.VarChar(32)
  destinationBranchCode         String? @db.VarChar(32)
  destinationAccountLast4       String  @db.VarChar(4)
  destinationAccountCiphertext  String  @db.VarChar(512)
  destinationAccountIv          String  @db.VarChar(32)
  destinationAccountTag         String  @db.VarChar(32)

  approvedAt            DateTime?
  approvedByAdminId     String?
  rejectedAt            DateTime?
  rejectedByAdminId     String?
  rejectionReason       String?  @db.VarChar(500)
  cancelledAt           DateTime?
  cancelledByAdminId    String?
  /// Why an approved request was closed without a bank transfer.
  cancellationReason    String?  @db.VarChar(500)
  paidAt                DateTime?
  paidByAdminId         String?
  /// When the administrator recorded the confirmation (server time).
  transferRecordedAt    DateTime?
  /// When the bank transfer actually occurred, as supplied by the admin.
  actualTransferredAt   DateTime?
  transferReference     String?  @unique @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                  @relation("WithdrawalOwner", fields: [userId], references: [id], onDelete: Restrict)
  bankAccount   AstrologerBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  approvedBy    User?                 @relation("WithdrawalApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: Restrict)
  rejectedBy    User?                 @relation("WithdrawalRejectedBy", fields: [rejectedByAdminId], references: [id], onDelete: Restrict)
  cancelledBy   User?                 @relation("WithdrawalCancelledBy", fields: [cancelledByAdminId], references: [id], onDelete: Restrict)
  paidBy        User?                 @relation("WithdrawalPaidBy", fields: [paidByAdminId], references: [id], onDelete: Restrict)
  debit         WithdrawalDebit?
  events        WithdrawalEvent[]

  @@unique([userId, clientIdempotencyKey])
  @@index([userId, status, createdAt])
  @@index([userId, purpose, status])
  @@index([status, createdAt])
  @@index([bankAccountId])
}

/// Immutable payout debit posted only when an admin records a confirmed transfer.
/// Kept separate from LedgerEntry because earning rows require a consultation snapshot
/// and must not be rewritten or reused as payouts.
model WithdrawalDebit {
  id                   String   @id @default(cuid())
  /// withdrawal:{withdrawalRequestId}:DEBIT
  idempotencyKey       String   @unique @db.VarChar(191)
  withdrawalRequestId  String   @unique
  userId               String
  amount               Decimal  @db.Decimal(12, 2)
  currency             String   @db.VarChar(8)
  createdAt            DateTime @default(now())

  withdrawalRequest WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model WithdrawalEvent {
  id           String                 @id @default(cuid())
  withdrawalId String
  actorUserId  String
  action       WithdrawalEventAction
  reason       String?                @db.VarChar(500)
  /// Safe metadata only. Never account numbers or encryption keys.
  metadata     Json?
  createdAt    DateTime               @default(now())

  withdrawal WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  actor      User              @relation("WithdrawalEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([withdrawalId, createdAt])
  @@index([actorUserId])
}
